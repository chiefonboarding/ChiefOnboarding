{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "buildAptPackages": [
    "gettext"
  ],
  "steps": {
    "build": {
      "commands": [
        "...",
        {
          "cmd": "django-admin compilemessages",
          "customName": "Compile translations"
        }
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "gettext"
    ],
    "startCommand": "exec python manage.py qcluster"
  }
}

