{
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "exists": {
    "url": "http://localhost:8000/test-integrations/?body={\"email\": \"{{ email }}\"}",
    "method": "GET",
    "expected": "{{ email }}"
  },
  "execute": [
    {
      "url": "http://localhost:8000/test-integrations/?status=201",
      "method": "POST",
      "data": {
        "email": "{{ email }}"
      },
      "status_code": ["201"]
    }
  ],
  "revoke": [
    {
      "url": "http://localhost:8000/test-integrations/?status=403&body={\"error\": \"Insufficient permissions to remove this user\"}",
      "method": "DELETE",
      "status_code": ["200", "204"]
    }
  ]
}
